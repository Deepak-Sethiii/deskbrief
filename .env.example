# Copy to .env and fill in. .env is gitignored and must never be committed.

# Groq API key for the LLM commentary stage (https://console.groq.com/keys).
# If unset, the pipeline still runs and falls back to a deterministic summary.
GROQ_API_KEY=

# Optional overrides
# DESKBRIEF_DB=data/deskbrief.db
# GROQ_MODEL=llama-3.3-70b-versatile
