# DeskBrief
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# real secrets never leave the machine; .env.example is the committed contract
.env

# generated artefacts
# data/ is deliberately NOT ignored: the SQLite database is committed so a CI run
# starts from the last known-good history instead of re-fetching a year of bars.
# Its WAL sidecars are transient though, and must never be committed alongside it.
data/*.db-wal
data/*.db-shm
output/
logs/
assets/*.png

# editor / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
~$*.xls*
